# konvoy env-spec schema, read by varlock (https://varlock.dev). No values here: they live in
# .env.local (gitignored) for a release cut by hand, or in the repository's GitHub secrets for
# the workflow. `bunx varlock run -- <cmd>` injects and redacts them. Nothing is required: the
# workflow skips each step whose secret is absent.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# ---- releasing ----

# PAT with contents:write on doguyilmaz/homebrew-tap - the release pushes Casks/konvoy.rb with it
# @type=string
# @docs(https://github.com/settings/tokens)
HOMEBREW_TAP_GITHUB_TOKEN=

# Developer ID Application certificate as a base64-encoded .p12, and its password
# @type=string
MACOS_SIGN_P12=
# @type=string
MACOS_SIGN_PASSWORD=

# App Store Connect API key for notarytool: issuer id, key id, and the .p8 contents
# @type=string
MACOS_NOTARY_ISSUER_ID=
# @type=string
MACOS_NOTARY_KEY_ID=
# @type=string
MACOS_NOTARY_KEY=

# ---- runtime ----

# set to 1 to make konvoy rethrow an error with its stack instead of printing one line
# @public @type=string
KONVOY_DEBUG=
