# konvoy — env-spec schema, read by varlock (https://varlock.dev).
# This file declares every variable the project knows about and carries no values. Values live
# in .env.local (gitignored) for a release cut by hand, or in the repository's GitHub secrets
# for the release workflow. A session — human or agent — can read this file for the full
# picture without ever seeing a secret; `bunx varlock run -- <cmd>` injects them and redacts them.
# Nothing here is required: the release workflow skips each step whose secret is absent, and a
# release cut by hand needs only the secrets of the steps it runs.
# @defaultRequired=false
# @defaultSensitive=true
# ---

# ---- releasing ----

# PAT with contents:write on doguyilmaz/homebrew-tap — the release pushes Casks/konvoy.rb with it
# @type=string
# @docs(https://github.com/settings/tokens)
HOMEBREW_TAP_GITHUB_TOKEN=

# npm granular access token with read and write on the konvoy package
# @type=string(startsWith="npm_")
# @docs(https://docs.npmjs.com/creating-and-viewing-access-tokens)
NPM_TOKEN=

# Developer ID Application certificate as a base64-encoded .p12, and its password
# @type=string
MACOS_SIGN_P12=
# @type=string
MACOS_SIGN_PASSWORD=

# App Store Connect API key for notarytool: issuer id, key id, and the .p8 contents
# @type=string
MACOS_NOTARY_ISSUER_ID=
# @type=string
MACOS_NOTARY_KEY_ID=
# @type=string
MACOS_NOTARY_KEY=

# ---- runtime ----

# set to 1 to make konvoy rethrow an error with its stack instead of printing one line
# @public @type=string
KONVOY_DEBUG=
